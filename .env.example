# Copy this file to .env and fill in the values for production.
# In development you do NOT need a .env file — the defaults in settings.py work fine.

# Required in production: generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-secret-key

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── MySQL Database ────────────────────────────────────────────────────────────
MYSQL_DATABASE=travelmate
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
